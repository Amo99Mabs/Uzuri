import React, { useState } from "react";
import { createProduct } from "../api";

const AddProductForm = ({ onCreated }) => {
  const [formData, setFormData] = useState({ name: "", price: 0, description: "", stock: 0 });
  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");
  const [saving, setSaving] = useState(false);

  const handleChange = (e) => {
    const { name, value } = e.target;
    setFormData((prev) => ({ ...prev, [name]: name === "price" || name === "stock" ? Number(value) : value })); };
  }; 
  const handleSubmit = async (e) => {
  e.preventDefault();
  setSaving(true);
  setError("");
  setSuccess("");
  try {
     const newProduct = await createProduct(formData);
     onCreated(newProduct);
     setFormData({ name: "", price: 0, description: "", stock: 0 });
     setSuccess("Product added successfully!");
  }  catch (err) {
     setError("Failed to add product.");
  }  finally {
     setSaving(false);
  }
}; 

return (
  <form onSubmit={handleSubmit} className="product-card">
  <h3>Add Product</h3>
  {error && <p className="error">{error}</p>}
  {success && <p className="success">{success}</p>
  <input name="name" value={formData.name} onChange={handleChange} placeholder="Name" required />
  <input name="price" type="number" value={formData.price} onChange={handleChange} placeholder="Price" required />
  <input name="description" value={formData.description} onChange={handleChange} placeholder="Description" />
  <input name="stock" type="number" value={formData.stock} onChange={handleChange} placeholder="Stock" />
  <button type="submit" className="btn-edit" disabled={saving}>
    {saving ? "Saving..." : "Add"} 
   </button> 
 </form> 
); 
}; 
export default AddProductForm;
